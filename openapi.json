{
  "openapi": "3.1.0",
  "info": {
    "title": "DocSlice Document Intelligence API",
    "description": "**DocSlice REST API** — Document Intelligence & Structured Extraction.\n\nConvert PDF, DOCX, RTF, TXT, CSV and images (OCR) into structured JSON, Markdown, or HTML.\n- **EU hosting** (Frankfurt, Germany); uploaded files are deleted right after processing.\n- **Bearer authentication**: pass your API key (`Authorization: Bearer ds_live_...`).\n- **Synchronous & Asynchronous Webhook** execution modes.\n\nFree API key: https://api.docslice.app/app#signup · Docs: https://docslice.app/docs/",
    "version": "1.0.0",
    "contact": {
      "name": "DocSlice",
      "email": "hello@docslice.app",
      "url": "https://docslice.app"
    }
  },
