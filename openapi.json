    },
    "/v1/convert/batch": {
      "post": {
        "tags": [
          "Document Conversion"
        ],
        "summary": "Batch convert multiple documents or a ZIP archive",
        "description": "Upload and convert multiple documents or a ZIP archive in a single request.\nFeatures:\n- Atomically processes multiple PDF, DOCX, TXT, or image files\n- Automatically unpacks .zip archives (with size and file-count limits)\n- Supports synchronous and asynchronous background execution\n- Provides itemized per-file results with partial error resilience\n- Strict GDPR Zero-Retention cleanup of uploaded files",
        "operationId": "convert_documents_batch_v1_convert_batch_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_convert_documents_batch_v1_convert_batch_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
